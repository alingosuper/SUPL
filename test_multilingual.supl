# --- سرائیکی ٹیسٹ ---
پندھ_شروع "سرائیکی_پروگرام"
    عدد عمر_سرائیکی = 25
    جے عمر_سرائیکی >= 18 تاں
        چھاپ "سرائیکی: آپ اہل ہیں۔"
    نہیں_تاں
        چھاپ "سرائیکی: چھوٹے ہیں۔"
پندھ_مک_گیا

# --- اردو ٹیسٹ ---
شروع "اردو_پروگرام"
    عدد عمر_اردو = 20
    اگر عمر_اردو >= 18 تو
        لکھو "اردو: آپ اہل ہیں۔"
    ورنہ
        لکھو "اردو: چھوٹے ہیں۔"
ختم

# --- پنجابی ٹیسٹ ---
شروع_کرو "پنجابی_پروگرام"
    گنتی عمر_پنجابی = 22
    جے عمر_پنجابی >= 18 تاں
        دسّو "پنجابی: تسیں وڈے او۔"
    نہیں_تاں
        دسّو "پنجابی: نکے او۔"
مک_گیا
