# --- اردو لوپ ٹیسٹ ---
شروع "اردو_لوپ_پروگرام"
    عدد گنتی = 1
    جب_تک گنتی <= 3
        لکھو گنتی
        گنتی = گنتی + 1
    ختم_لوپ
ختم

# --- سرائیکی لوپ ٹیسٹ ---
پندھ_شروع "سرائیکی_لوپ_پروگرام"
    عدد گنتی_سرائیکی = 1
    جب_تک گنتی_سرائیکی <= 3
        چھاپ گنتی_سرائیکی
        گنتی_سرائیکی = گنتی_سرائیکی + 1
    ختم_لوپ
پندھ_مک_گیا
