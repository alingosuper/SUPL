# SUPL Interpreter & UI Engine — النگو ڈویلپرز (Ultimate)
import sys
from pathlib import Path

sys.path.append(str(Path(__file__).resolve().parent))
from lexer.lexer import Lexer
from parser.parser import Parser
from urdu.runtime.naksha import NakshaUI
from urdu.runtime import builtins as _ALINGO_BUILTINS

_ALINGO_NAMES = {
    'لکھو': _ALINGO_BUILTINS.لکھو,
    'پڑھو': _ALINGO_BUILTINS.پڑھو,
    'عدد':  _ALINGO_BUILTINS.عدد,
    'متن':  _ALINGO_BUILTINS.متن,
    'فہرست': _ALINGO_BUILTINS.فہرست,
    'لغت':  _ALINGO_BUILTINS.لغت,
    'لمبائی': _ALINGO_BUILTINS.لمبائی,
    'قسم':  _ALINGO_BUILTINS.قسم,
    'حد':   _ALINGO_BUILTINS.حد,
    'گنو':  _ALINGO_BUILTINS.گنو,
}

class _ReturnException(Exception):
    def __init__(self, value):
        self.value = value

class Interpreter:
    def __init__(self, parser):
        self.parser = parser
        self.variables = {}
        self.ui = NakshaUI("سرائیکی زبردست ایپ")

    def interpret(self):
        try:
            ast = self.parser.parse()
            if ast:
                print(f"--- پروگرام شروع: {ast['name']} (النگو ڈویلپرز) ---")
                self.ui.صفحہ_شروع(ast['name'])
                self.execute_ast(ast)
                self.ui.صفحہ_ختم()
                self.ui.محفوظ_کرو("supl_out.html")
                print("--- پندھ مک گیا (ویب UI محفوظ ہو گیا ہے) ---")
        except Exception as e:
            print(f"خرابی: {e}")

    def execute_ast(self, node):
        if not node: return None
        ntype = node.get("type")

        if ntype == "Program":
            for stmt in node["body"]:
                self.execute_ast(stmt)

        elif ntype == "Import":
            module_path = node["module"]
            from pathlib import Path

            candidate = Path(module_path)
            if not candidate.exists() and hasattr(self, "_current_file") and self._current_file:
                candidate = Path(self._current_file).parent / module_path

            if not candidate.exists():
                raise FileNotFoundError(f"ماڈیول نہیں ملا: {module_path}")

            module_code = candidate.read_text(encoding="utf-8")
            from lexer.lexer import Lexer
            from parser.parser import Parser

            # ماڈیول کو پندھ_شروع/پندھ_مک_گیا میں لپیٹیں (اگر پہلے سے نہ ہوں)
            if "پندھ_شروع" not in module_code:
                module_code = f'پندھ_شروع "imported_module"\n{module_code}\nپندھ_مک_گیا'

            sub_parser = Parser(Lexer(module_code))
            sub_ast = sub_parser.parse()

            old_file = getattr(self, "_current_file", None)
            self._current_file = str(candidate)
            try:
                self.execute_ast(sub_ast)
            finally:
                self._current_file = old_file

        elif ntype == "Print":
            vals = [self.eval_expr(a) for a in node["args"]]
            _ALINGO_BUILTINS.لکھو(*vals)

        elif ntype == "PropertySet":
            obj = self.eval_expr(node["object"])
            value = self.eval_expr(node["value"])
            if not isinstance(obj, dict) or "__class__" not in obj:
                raise TypeError("پراپرٹی صرف آبجیکٹ میں مقرر ہو سکتی ہے")
            obj.setdefault("__attrs__", {})[node["property"]] = value

        elif ntype == "VarDecl" or ntype == "Assignment":
            # اگر قدر ایک New ہے تو آبجیکٹ بنائیں
            val = self.eval_expr(node["value"])
            self.variables[node["name"]] = val

        elif ntype == "Function":
            self.variables[node["name"]] = {
                "type": "function",
                "params": node["params"],
                "body": node["body"]
            }

        elif ntype == "Class":
            methods = {}
            constructor = None
            for m in node["methods"]:
                if m.get("type") == "Function":
                    methods[m["name"]] = m
                elif m.get("type") == "Constructor":
                    constructor = m
            self.variables[node["name"]] = {
                "type": "class",
                "name": node["name"],
                "methods": methods,
                "constructor": constructor
            }

        elif ntype == "New":
            class_name = node["class"]
            if class_name not in self.variables or self.variables[class_name].get("type") != "class":
                raise Exception(f"کلاس نہیں ملی: {class_name}")
            
            cls = self.variables[class_name]
            obj = {"__class__": cls}
            
            # constructor چلائیں
            if cls["constructor"]:
                ctor = cls["constructor"]
                old_vars = self.variables.copy()
                args = [self.eval_expr(a) for a in node["args"]]
                for param, arg in zip(ctor["params"], args):
                    self.variables[param] = arg
                self.variables["یہ"] = obj
                try:
                    for stmt in ctor["body"]:
                        self.execute_ast(stmt)
                except _ReturnException:
                    pass
                self.variables = old_vars
            
            return obj

        elif ntype == "MethodCall":
            obj = self.eval_expr(node["object"])
            method_name = node["method"]
            args = [self.eval_expr(a) for a in node["args"]]

            # ─── Built-in list methods ───
            if isinstance(obj, list):
                if method_name == "شامل_کریں":
                    obj.append(args[0])
                    return None
                elif method_name == "لمبائی":
                    return len(obj)
                elif method_name == "کڈھو":
                    try:
                        obj.remove(args[0])
                    except ValueError:
                        raise ValueError(f"'{args[0]}' فہرست میں نہیں ملا")
                    return None
                elif method_name == "ہٹاؤ":
                    return obj.pop(args[0]) if args else obj.pop()
                elif method_name == "ترتیب_دو":
                    obj.sort()
                    return None
                elif method_name == "الٹا_کرو":
                    obj.reverse()
                    return None
                else:
                    raise AttributeError(f"فہرست دا طریقہ نہیں لبھیا: {method_name}")

            # ─── Built-in string methods ───
            if isinstance(obj, str):
                if method_name == "لمبائی":
                    return len(obj)
                elif method_name == "بڑا_کریں":
                    return obj.upper()
                elif method_name == "چھوٹا_کریں":
                    return obj.lower()
                elif method_name == "بدلو":
                    if len(args) != 2:
                        raise TypeError("بدلو دو آرگومنٹس چاہندا ہے")
                    return obj.replace(str(args[0]), str(args[1]))
                elif method_name == "شامل_ہے":
                    return str(args[0]) in obj
                else:
                    raise AttributeError(f"String دا طریقہ نہیں لبھیا: {method_name}")

            # ─── User-defined class methods ───
            if not isinstance(obj, dict) or "__class__" not in obj:
                raise TypeError(f"MethodCall کے لیے درست آبجیکٹ درکار ہے (ملا: {type(obj).__name__})")

            cls = obj["__class__"]
            method = cls.get("methods", {}).get(method_name)

            if method is None:
                raise AttributeError(f"طریقہ نہیں ملا: {method_name}")

            params = method.get("params", [])
            if len(args) != len(params):
                raise TypeError(
                    f"طریقہ {len(params)} آرگومنٹس چاہتا ہے، {len(args)} دیے گئے"
                )

            old_vars = self.variables.copy()
            try:
                for param, arg in zip(params, args):
                    self.variables[param] = arg

                self.variables["یہ"] = obj

                for stmt in method["body"]:
                    self.execute_ast(stmt)

            except _ReturnException as exc:
                return exc.value
            finally:
                self.variables = old_vars

        elif ntype == "TryCatch":
            try:
                for stmt in node["try_body"]:
                    self.execute_ast(stmt)
            except Exception as e:
                # غلطی کو متغیر میں رکھیں
                self.variables[node["catch_var"]] = str(e)
                for stmt in node["catch_body"]:
                    self.execute_ast(stmt)

        elif ntype == "Return":
            value = self.eval_expr(node["value"])
            raise _ReturnException(value)

        elif ntype == "Call":
            name = node["name"]
            args = [self.eval_expr(a) for a in node["args"]]
            
            # صارف کا فنکشن
            if name in self.variables and isinstance(self.variables[name], dict) and self.variables[name].get("type") == "function":
                func = self.variables[name]
                old_vars = self.variables.copy()
                for param, arg in zip(func["params"], args):
                    self.variables[param] = arg
                try:
                    for stmt in func["body"]:
                        self.execute_ast(stmt)
                except _ReturnException as e:
                    self.variables = old_vars
                    return e.value
                self.variables = old_vars
                return None
            
            # builtin
            elif name in _ALINGO_NAMES:
                return _ALINGO_NAMES[name](*args)
            else:
                _ALINGO_BUILTINS.لکھو(*args)

        elif ntype == "If":
            met = self.eval_expr(node["cond"])
            if met:
                for stmt in node["body"]:
                    self.execute_ast(stmt)
            else:
                for stmt in node["else_body"]:
                    self.execute_ast(stmt)

        elif ntype == "While":
            while self.eval_expr(node["cond"]):
                for stmt in node["body"]:
                    self.execute_ast(stmt)

        elif ntype == "For":
            start = self.eval_expr(node["start"])
            end = self.eval_expr(node["end"])
            for i in range(int(start), int(end)):
                self.variables[node["var"]] = i
                for stmt in node["body"]:
                    self.execute_ast(stmt)

    def call_function(self, name, args):
        # User-defined function
        func = self.variables.get(name)

        if isinstance(func, dict) and func.get("type") == "function":
            params = func["params"]

            if len(params) != len(args):
                raise TypeError(
                    f"فنکشن {name}: مطلوبہ آرگومنٹس {len(params)}، "
                    f"موصول ہوئے {len(args)}"
                )

            old_vars = self.variables.copy()

            try:
                for param, arg in zip(params, args):
                    self.variables[param] = arg

                for stmt in func["body"]:
                    self.execute_ast(stmt)

            except _ReturnException as result:
                return result.value

            finally:
                self.variables = old_vars

            return None

        # Built-in functions
        if name in _ALINGO_NAMES:
            return _ALINGO_NAMES[name](*args)

        raise NameError(f"فنکشن نہیں ملا: {name}")

    def eval_expr(self, node):
        if node is None:
            return None

        ntype = node.get("type")

        if ntype == "New":
            class_name = node["class"]
            cls = self.variables.get(class_name)
            if not isinstance(cls, dict) or cls.get("type") != "class":
                raise NameError(f"کلاس نہیں ملی: {class_name}")

            args = [self.eval_expr(a) for a in node["args"]]
            ctor = cls.get("constructor")
            obj = {"__class__": cls, "__attrs__": {}}

            if ctor:
                params = ctor["params"]
                if len(args) != len(params):
                    raise TypeError(
                        f"کنسٹرکٹر {len(params)} آرگومنٹس چاہتا ہے، {len(args)} دیے گئے"
                    )
                old_vars = self.variables.copy()
                try:
                    for param, arg in zip(params, args):
                        self.variables[param] = arg
                    self.variables["یہ"] = obj
                    for stmt in ctor["body"]:
                        self.execute_ast(stmt)
                except _ReturnException:
                    pass
                finally:
                    self.variables = old_vars

            return obj

        elif ntype == "PropertyGet":
            obj = self.eval_expr(node["object"])
            if not isinstance(obj, dict):
                raise TypeError("پراپرٹی حاصل کرنے کے لیے آبجیکٹ درکار ہے")
            attrs = obj.get("__attrs__", {})
            prop = node["property"]
            if prop not in attrs:
                raise AttributeError(f"پراپرٹی نہیں ملی: {prop}")
            return attrs[prop]

        if ntype == "MethodCall":
            obj = self.eval_expr(node["object"])
            method_name = node["method"]
            args = [self.eval_expr(a) for a in node["args"]]

            if isinstance(obj, str):
                if method_name == "لمبائی":
                    return len(obj)
                elif method_name == "بڑا_کریں":
                    return obj.upper()
                elif method_name == "چھوٹا_کریں":
                    return obj.lower()
                elif method_name == "بدلو":
                    if len(args) != 2:
                        raise TypeError("بدلو دو آرگومنٹس چاہندا ہے")
                    return obj.replace(str(args[0]), str(args[1]))
                else:
                    raise AttributeError(f"String دا طریقہ نہیں لبھیا: {method_name}")

            if isinstance(obj, dict) and "__class__" in obj:
                cls = obj["__class__"]
                method = cls.get("methods", {}).get(method_name)
                if method is None:
                    raise AttributeError(f"طریقہ نہیں لبھیا: {method_name}")

                params = method.get("params", [])
                if len(args) != len(params):
                    raise TypeError("طریقے دے آرگومنٹس دی تعداد غلط ہے")

                old_vars = self.variables.copy()
                try:
                    for param, arg in zip(params, args):
                        self.variables[param] = arg
                    self.variables["یہ"] = obj

                    for stmt in method["body"]:
                        self.execute_ast(stmt)

                except _ReturnException as exc:
                    return exc.value
                finally:
                    self.variables = old_vars

                return None

            raise TypeError("ایہہ آبجیکٹ طریقہ کال نہیں کر سکدا")

        if ntype == "Self":
            return self.variables.get("یہ")
        elif ntype == "Literal":
            # String values must NEVER be resolved as variables
            return node["value"]

        elif ntype == "Identifier":
            name = node["name"]
            if name not in self.variables:
                raise NameError(f"متغیر نہیں ملا: {name}")
            return self.variables[name]

        elif ntype == "Call":
            args = [self.eval_expr(a) for a in node["args"]]
            return self.call_function(node["name"], args)

        elif ntype == "IndexAccess":
            obj = self.eval_expr(node["object"])
            index = self.eval_expr(node["index"])
            return obj[index]

        elif ntype == "List":
            return [self.eval_expr(e) for e in node["elements"]]

        elif ntype == "Dict":
            return {
                self.eval_expr(k): self.eval_expr(v)
                for k, v in node["pairs"]
            }

        elif ntype == "BinaryOp":
            left = self.eval_expr(node["left"])
            right = self.eval_expr(node["right"])
            op = node["op"]

            if op in ("+", "PLUS"):
                return left + right
            elif op in ("-", "MINUS"):
                return left - right
            elif op in ("*", "STAR"):
                return left * right
            elif op in ("/", "SLASH"):
                return left / right
            elif op in (">", "GREATER"):
                return left > right
            elif op in ("<", "LESS"):
                return left < right
            elif op in (">=", "GREATER_EQUAL"):
                return left >= right
            elif op in ("<=", "LESS_EQUAL"):
                return left <= right
            elif op in ("==", "EQUAL_EQUAL"):
                return left == right
            elif op in ("!=", "NOT_EQUAL"):
                return left != right

            raise ValueError(f"نامعلوم آپریٹر: {op}")

        raise TypeError(f"نامعلوم Expression: {ntype}")
