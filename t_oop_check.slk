پندھ_شروع "oop_check"
    کلاس گاڑی {
        تعمیر(رنگ) {
            یہ.رنگ = رنگ
        }
        فنکشن دکھاؤ() {
            لکھو("میتھڈ کامیاب")
            لکھو("رنگ:", یہ.رنگ)
        }
    }
    میری_گاڑی = نیا گاڑی("لال")
    لکھو("پراپرٹی:", میری_گاڑی.رنگ)
    میری_گاڑی.دکھاؤ()
پندھ_مک_گیا
