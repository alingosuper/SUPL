# سرائیکی ٹیسٹ
پندھ_شروع "سرائیکی"
    عدد عمر = 20
    جے عمر >= 18 تاں
        چھاپ "سرائیکی: آپ ووٹ ڈال سکتے ہیں۔"
پندھ_مک_گیا

# اردو ٹیسٹ
شروع "اردو"
    عدد عمر = 20
    اگر عمر >= 18 تو
        لکھو "اردو: آپ ووٹ ڈال سکتے ہیں۔"
ختم

# پنجابی ٹیسٹ
شروع_کرو "پنجابی"
    گنتی عمر = 20
    جے عمر >= 18 تاں
        دسّو "پنجابی: تسیں ووٹ پا سکدے او۔"
مک_گیا
