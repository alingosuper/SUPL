#!/data/data/com.termux/files/usr/bin/bash
# ═══════════════════════════════════════════════════════════
# سرائیکی — پیکیج مینیجر (pip کا سرائیکی نام)
# تخلیق کار: النگو ڈویلپرز (AlinGo Developers)
# ═══════════════════════════════════════════════════════════

# پہلا آرگیومنٹ
CMD="$1"
shift 2>/dev/null

# کمانڈ کو سرائیکی سے انگریزی میں بدلیں
case "$CMD" in
    نصب|لڳاؤ|لگاؤ|install|i)
        python3 -m pip install "$@"
        ;;
    ہٹاؤ|ہٹاو|کڍو|کڈھو|uninstall|remove|rm)
        python3 -m pip uninstall "$@"
        ;;
    فہرست|لسٹ|list|ls)
        python3 -m pip list "$@"
        ;;
    ڈکھاؤ|دکھاو|وکھاؤ|show|info)
        python3 -m pip show "$@"
        ;;
    بند|منجمد|freeze)
        python3 -m pip freeze "$@"
        ;;
    ڳولو|ڳول|تلاش|search|find)
        python3 -m pip search "$@" 2>/dev/null || echo "⚠️ pip search اب معاون نہیں — https://pypi.org استعمال کریں"
        ;;
    مدد|help|-h|--help)
        cat << 'HELP_EOF'
═══════════════════════════════════════════════════════════
  سرائیکی — پیکیج مینیجر (pip کا سرائیکی نام)
  تخلیق کار: النگو ڈویلپرز (AlinGo Developers)
═══════════════════════════════════════════════════════════

استعمال:
  سرائیکی نصب <پیکیج>           — پیکیج نصب کریں
  سرائیکی ہٹاؤ <پیکیج>           — پیکیج ہٹائیں
  سرائیکی فہرست                 — نصب شدہ پیکیجز
  سرائیکی ڈکھاؤ <پیکیج>          — تفصیل
  سرائیکی بند                   — installed packages
  سرائیکی اپگریڈ <پیکیج>         — اپ گریڈ
  سرائیکی ڈاؤنلوڈ <پیکیج>        — صرف ڈاؤن لوڈ

انگریزی کمانڈز بھی چلیں گی:
  سرائیکی install <پیکیج>
  سرائیکی uninstall <پیکیج>
  سرائیکی list
  سرائیکی show <پیکیج>

═══════════════════════════════════════════════════════════
HELP_EOF
        ;;
    اپگریڈ|اپ_گریڈ|upgrade|up)
        python3 -m pip install --upgrade "$@"
        ;;
    ڈاؤنلوڈ|ڈاؤن_لوڈ|download|dl)
        python3 -m pip download "$@"
        ;;
    نسخہ|ورژن|version|--version|-V)
        echo "سرائیکی پیکیج مینیجر v1.0.0 — النگو ڈویلپرز"
        python3 -m pip --version
        ;;
    "")
        python3 -m pip
        ;;
    *)
        python3 -m pip "$CMD" "$@"
        ;;
esac

exit $?
