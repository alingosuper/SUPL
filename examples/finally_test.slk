پندھ_شروع "finally ٹیسٹ"

# ═══ 1. کوشش کامیاب، آخر_میں چلے گا ═══
لکھو("═══ ٹیسٹ 1: کامیاب کوشش ═══")
کوشش {
    لکھو("کوشش میں ہوں")
    شے x = 10 جمع 20
    لکھو("نتیجہ:", x)
} پکڑو(غلطی) {
    لکھو("پکڑو میں ہوں:", غلطی)
} آخر_میں {
    لکھو("آخر_میں ہمیشہ چلتا ہے")
}

# ═══ 2. کوشش ناکام، آخر_میں پھر بھی چلے گا ═══
لکھو("")
لکھو("═══ ٹیسٹ 2: ناکام کوشش ═══")
کوشش {
    لکھو("کوشش میں ہوں")
    شے y = 10 ونڈ 0
    لکھو("یہ نہیں چلے گا")
} پکڑو(غلطی) {
    لکھو("پکڑو میں ہوں:", غلطی)
} آخر_میں {
    لکھو("آخر_میں ہمیشہ چلتا ہے")
}

# ═══ 3. صرف کوشش، کوئی آخر_میں نہیں ═══
لکھو("")
لکھو("═══ ٹیسٹ 3: کوئی آخر_میں نہیں ═══")
کوشش {
    لکھو("کوشش میں ہوں")
} پکڑو(غلطی) {
