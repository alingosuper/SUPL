پندھ_شروع "stdlib ٹیسٹ"

# ═══ 1. ڳنتری (Math) ═══
لکھو("═══ ڳنتری ═══")
شامل_کرو "ڳنتری"
لکھو("π =", ڳنتری.پائی)
لکھو("√16 =", ڳنتری.جذر(16))
لکھو("2^10 =", ڳنتری.طاقت(2, 10))
لکھو("|-42| =", ڳنتری.مطلق(0 - 42))

# ═══ 2. ویلہ (Time) ═══
لکھو("")
لکھو("═══ ویلہ ═══")
شامل_کرو "ویلہ"
لکھو("ابھی:", ویلہ.اب())
لکھو("آج:", ویلہ.آج())
لکھو("سال:", ویلہ.سال())

# ═══ 3. ڈیٹا (Data — JSON) ═══
لکھو("")
لکھو("═══ ڈیٹا ═══")
شامل_کرو "ڈیٹا"
شے json_متن = ڈیٹا.json_میں({"نام": "علی", "عمر": 25})
لکھو("JSON:", json_متن)

# ═══ 4. فائلاں (Files) ═══
لکھو("")
لکھو("═══ فائلاں ═══")
شامل_کرو "فائلاں"
فائلاں.لکھو("test.txt", "السلام علیکم!\nیہ ایک ٹیسٹ ہے۔\n")
لکھو("فائل لکھی گئی")
لکھو("مواد:", فائلاں.پڑھو("test.txt"))
لکھو("موجود ہے:", فائلاں.موجود_ہے("test.txt"))

# ═══ 5. ویب (Web — صرف ٹیسٹ) ═══
لکھو("")
لکھو("═══ ویب ═══")
شامل_کرو "ویب"
لکھو("ویب ماڈیول لوڈ ہو گیا")

پندھ_مک_گیا
