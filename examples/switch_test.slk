پندھ_شروع "switch ٹیسٹ"

# ═══ SWITCH — اردو (منتخب) ═══
لکھو("═══ SWITCH — اردو ═══")
شے x = 2
منتخب x {
    صورت 1 {
        لکھو("ایک")
    }
    صورت 2 {
        لکھو("دو")
    }
    صورت 3 {
        لکھو("تین")
    }
    ڈیفالٹ {
        لکھو("اور کچھ")
    }
}

# ═══ SWITCH — سرائیکی (چنو) ═══
لکھو("")
لکھو("═══ SWITCH — سرائیکی ═══")
شے y = 5
چنو y {
    صورت 1 { لکھو("ایک") }
    صورت 5 { لکھو("پانچ") }
    بصورت_دیگر { لکھو("کچھ اور") }
}

# ═══ SWITCH — ڈیفالٹ ═══
لکھو("")
لکھو("═══ SWITCH — ڈیفالٹ ═══")
شے z = 99
منتخب z {
    صورت 1 { لکھو("ایک") }
    صورت 2 { لکھو("دو") }
    ڈیفالٹ { لکھو("ڈیفالٹ چلا!") }
}

پندھ_مک_گیا
