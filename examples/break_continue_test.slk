پندھ_شروع "break_continue ٹیسٹ"

# ═══ BREAK — `توڑ_دو` ═══
لکھو("═══ BREAK ٹیسٹ ═══")
شے x = 0
جدوں_تئیں x نکا 10 {
    جے x برابر 5 {
        لکھو("رک گیا x =", x)
        توڑ_دو
    }
    لکھو("x =", x)
    x = x جمع 1
}

# ═══ CONTINUE — `اگے_ٹرو` ═══
لکھو("")
لکھو("═══ CONTINUE ٹیسٹ ═══")
برائے i میں 0 تک 10 {
    جے i برابر 3 {
        اگے_ٹرو
    }
    لکھو("i =", i)
}

# ═══ روک_ڈیو (سرائیکی) ═══
لکھو("")
لکھو("═══ روک_ڈیو ٹیسٹ ═══")
شے y = 0
جدوں_تئیں y نکا 5 {
    جے y برابر 3 {
        لکھو("رک گیا y =", y)
        روک_ڈیو
    }
    y = y جمع 1
}

# ═══ جاری_رکھو (اردو) ═══
لکھو("")
لکھو("═══ جاری_رکھو ٹیسٹ ═══")
برائے j میں 0 تک 5 {
    جے j برابر 2 {
        جاری_رکھو
    }
    لکھو("j =", j)
}

پندھ_مک_گیا
