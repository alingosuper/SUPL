پندھ_شروع "محفوظ_پروگرام"
    سرخی "سرائیکی سیکیورٹی اور فائر وال سسٹم"
    
    # جدید سیکیورٹی بلاک
    محفوظ ان پٹ_کی_جانچ
        عدد پاس ورڈ = 1234
        جے پاس ورڈ == 1234 تاں
            چھاپ "سیکیورٹی تصدیق کامیاب: سسٹم محفوظ ہے۔"
            بٹن "محفوظ ڈیش بورڈ کھولیں"
        نہیں_تاں
            چھاپ "خبردار! غیر مجاز رسائی کی کوشش پکڑی گئی۔"
    پندھ_مک_گیا
