پندھ_شروع "ٹوڈو_ایپ"

# ─── todo_model.slk کا مواد یہاں ───
کلاس ٹوڈو_آئٹم {
    تعمیر(عنوان) {
        یہ.عنوان = عنوان
        یہ.مکمل = "نہیں"
    }
    فنکشن دکھاؤ() {
        لکھو("[", یہ.مکمل, "]", یہ.عنوان)
    }
    فنکشن مکمل_کریں() {
        یہ.مکمل = "ہاں"
    }
}

کلاس ٹوڈو_لسٹ {
    تعمیر() {
        یہ.اشیاء = []
    }
    فنکشن شامل_کریں(عنوان) {
        آئٹم = نیا ٹوڈو_آئٹم(عنوان)
        یہ.اشیاء.شامل_کریں(آئٹم)
        لکھو("شامل کیا گیا:", عنوان)
    }
    فنکشن سب_دکھائیں() {
        لکھو("─── تمام ٹوڈو ───")
        برائے i میں 0 تک یہ.اشیاء.لمبائی() {
            لکھو("آئٹم نمبر:", i)
        }
    }
    فنکشن مکمل_کریں() {
        لکھو("مکمل کرنے کی کوشش")
    }
}

# ─── main.slk کا مواد ───
لکھو("═══════════════════════════════════════")
لکھو("   AlinGo ٹوڈو ایپ — مکمل ڈیمو")
لکھو("═══════════════════════════════════════")

میری_لسٹ = نیا ٹوڈو_لسٹ()

لکھو("")
لکھو("─── ٹوڈو شامل کر رہے ہیں ───")
میری_لسٹ.شامل_کریں("اردو پروگرامنگ سیکھنا")
میری_لسٹ.شامل_کریں("AlinGo زبان کو مکمل کرنا")
میری_لسٹ.شامل_کریں("ٹوڈو ایپ بنانا")

لکھو("")
لکھو("─── تمام ٹوڈو دکھا رہے ہیں ───")
میری_لسٹ.سب_دکھائیں()

لکھو("")
لکھو("─── ٹوڈو مکمل کر رہے ہیں ───")
میری_لسٹ.مکمل_کریں()

لکھو("")
لکھو("═══════════════════════════════════════")
لکھو("   ٹوڈو ایپ مکمل!")
لکھو("═══════════════════════════════════════")

