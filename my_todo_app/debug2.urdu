پندھ_شروع "debug2"
کلاس ٹیسٹ {
    تعمیر(نام) {
        یہ.نام = نام
    }
}
کلاس لسٹ {
    تعمیر() {
        یہ.اشیاء = []
    }
    فنکشن شامل_کریں(نام) {
        آئٹم = نیا ٹیسٹ(نام)
        یہ.اشیاء.شامل_کریں(آئٹم)
    }
    فنکشن دکھاؤ_سب() {
        لکھو("لمبائی:", یہ.اشیاء.لمبائی())
        لکھو("i=0:", یہ.اشیاء[0])
    }
}
ل = نیا لسٹ()
ل.شامل_کریں("علی")
ل.دکھاؤ_سب()
پندھ_مک_گیا
