# ٹوڈو ماڈل — Indexing کے ساتھ

کلاس ٹوڈو_آئٹم {
    تعمیر(عنوان) {
        یہ.عنوان = عنوان
        یہ.مکمل = "نہیں"
    }
    فنکشن دکھاؤ() {
        لکھو("[", یہ.مکمل, "]", یہ.عنوان)
    }
    فنکشن مکمل_کریں() {
        یہ.مکمل = "ہاں"
    }
}

کلاس ٹوڈو_لسٹ {
    تعمیر() {
        یہ.اشیاء = []
    }
    فنکشن شامل_کریں(عنوان) {
        آئٹم = نیا ٹوڈو_آئٹم(عنوان)
        یہ.اشیاء.شامل_کریں(آئٹم)
        لکھو("شامل کیا گیا:", عنوان)
    }
    فنکشن سب_دکھائیں() {
        لکھو("─── تمام ٹوڈو ───")
        برائے i میں 0 تک یہ.اشیاء.لمبائی() {
            یہ.اشیاء[i].دکھاؤ()
        }
    }
    فنکشن مکمل_کریں(انڈیکس) {
        کوشش {
            یہ.اشیاء[انڈیکس].مکمل_کریں()
            لکھو("مکمل ہو گیا:", یہ.اشیاء[انڈیکس].عنوان)
        } پکڑو(غلطی) {
            لکھو("خرابی:", غلطی)
        }
    }
}

لکھو("ٹوڈو ماڈل لوڈ ہو گیا")
