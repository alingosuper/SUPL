پندھ_شروع "debug"
کلاس ٹیسٹ {
    تعمیر(نام) {
        یہ.نام = نام
    }
    فنکشن دکھاؤ() {
        لکھو("دکھا رہا:", یہ.نام)
    }
}
کلاس لسٹ {
    تعمیر() {
        یہ.اشیاء = []
    }
    فنکشن شامل_کریں(نام) {
        آئٹم = نیا ٹیسٹ(نام)
        یہ.اشیاء.شامل_کریں(آئٹم)
        لکھو("آئٹم شامل ہوا")
    }
    فنکشن دکھاؤ_سب() {
        برائے i میں 0 تک یہ.اشیاء.لمبائی() {
            لکھو("i =", i)
            یہ.اشیاء[i].دکھاؤ()
        }
    }
}
ل = نیا لسٹ()
ل.شامل_کریں("علی")
ل.دکھاؤ_سب()
پندھ_مک_گیا
